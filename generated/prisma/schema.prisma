generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ADMIN
  MANAGER
  STAFF
  AFFILIATE
}

enum WalletTransferStatus {
  PENDING
  RECEIVED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ============================================
// User
// ============================================

model User {
  id           String      @id @default(uuid())
  username     String
  email        String      @unique
  phone        String?
  avatar       String?
  accountType  AccountType @default(STAFF)
  password     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  permissionId String?
  parentId     String?

  // ─── E-commerce Affiliate columns ───
  isAffiliate          Boolean   @default(false)
  affiliateApproved    Boolean   @default(false)
  affiliateCode        String?   @unique
  affiliateRequestedAt DateTime?
  affiliateApprovedAt  DateTime?

  // ─── Relations ───
  parent          User?                     @relation("UserToSubordinates", fields: [parentId], references: [id])
  subordinates    User[]                    @relation("UserToSubordinates")
  orders          Order[]
  walletTransfers AffiliateWalletTransfer[]
  permission      Permission?               @relation(fields: [permissionId], references: [id])
  customers       Customer[]                @relation("CustomerToUser")

  // ─── E-commerce Affiliate Relations ───
  affiliateLinks AffiliateLink[]
  reviews        Review[]
}

// ============================================
// Permission
// ============================================

model Permission {
  id       String @id @default(uuid())
  roleName String

  viewProducts   Boolean @default(false)
  addProducts    Boolean @default(false)
  editProducts   Boolean @default(false)
  deleteProducts Boolean @default(false)

  viewReports   Boolean @default(false)
  addReports    Boolean @default(false)
  editReports   Boolean @default(false)
  deleteReports Boolean @default(false)

  viewOrders   Boolean @default(false)
  addOrders    Boolean @default(false)
  editOrders   Boolean @default(false)
  deleteOrders Boolean @default(false)

  viewCustomers   Boolean @default(false)
  addCustomers    Boolean @default(false)
  editCustomers   Boolean @default(false)
  deleteCustomers Boolean @default(false)

  viewCategories   Boolean @default(false)
  addCategories    Boolean @default(false)
  editCategories   Boolean @default(false)
  deleteCategories Boolean @default(false)

  viewPermissions   Boolean @default(false)
  editPermissions   Boolean @default(false)
  addPermissions    Boolean @default(false)
  deletePermissions Boolean @default(false)

  viewPages   Boolean @default(false)
  addPages    Boolean @default(false)
  editPages   Boolean @default(false)
  deletePages Boolean @default(false)

  users User[]
}

// ============================================
// Category
// ============================================

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  // ─── E-commerce columns ───
  image     String?
  slug      String?  @unique
  isVisible Boolean  @default(false)
  createdAt DateTime @default(now())

  products       Product[]
  offerDiscounts OfferDiscount[]
}

// ============================================
// Product
// ============================================

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  modelNumber String?
  barcode     String?
  description String?
  googleLink  String?
  categoryId  Int?
  createdAt   DateTime @default(now())

  // ─── E-commerce columns ───
  seoSlug                 String? @unique
  metaTitle               String?
  metaDescription         String?
  metaKeywords            String?
  isActive                Boolean @default(true)
  showInAds               Boolean @default(false)
  affiliatePrice          Float   @default(0)
  affiliateCommissionRate Float?  @default(10.00)

  // ─── Relations ───
  orderItems   OrderItem[]
  category     Category?      @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  adPageVisits AdPageVisit[]

  // ─── E-commerce Relations ───
  affiliateLinks AffiliateLink[]
  reviews        Review[]
  landingPage    ProductLandingPage?
  offerDiscounts OfferDiscount[]

  // ─── Variants (Colors & Sizes) ───
  variants ProductVariant[]
}

model Color {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  hexCode  String?
  variants ProductVariant[]
}

model Size {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  variants ProductVariant[]
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  colorId   Int?
  sizeId    Int?
  price     Float   @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)
  size      Size?   @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@unique([productId, colorId, sizeId])
  @@index([productId])
}

model AdPageVisit {
  id         String   @id @default(uuid())
  productId  Int      @map("product_id")
  visitorId  String   @map("visitor_id")
  path       String?
  referrer   String?
  userAgent  String?  @map("user_agent")
  browser    String?
  os         String?
  deviceType String?  @map("device_type")
  locale     String?
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([visitorId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@map("ad_page_visits")
}

// ============================================
// ProductLandingPage (Landing Page Content per Product)
// ============================================

model ProductLandingPage {
  id        String  @id @default(cuid())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Hero content overrides
  heroTitle             String?
  heroSubtitle          String?
  heroDescription       String?
  badgeText             String?
  discountPercent       Int?
  quantityDiscountTiers Json?   @default("[]")

  // Features section (JSON array of { title, description })
  features Json? @default("[]")

  // Trust / Guarantee
  showReviews    Boolean @default(true)
  showGuarantee  Boolean @default(true)
  guaranteeTitle String?
  guaranteeText  String?

  // CTA
  ctaText String?

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_landing_pages")
}

// ============================================
// Review
// ============================================

model Review {
  id         String   @id @default(uuid())
  productId  Int      @map("product_id")
  userId     String?  @map("user_id")
  name       String
  rating     Int
  comment    String?
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("reviews")
}

// ============================================
// ProductImage
// ============================================

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  type      String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================
// Customer
// ============================================

model Customer {
  id          String   @id @default(uuid())
  name        String   @unique
  email       String?
  phone       String[]
  countryCode String?
  phonestatus String?
  country     String?
  gender      String?
  age         String?
  source      String?
  city        String?
  rating      Int?
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  users       User[]   @relation("CustomerToUser")
}

// ============================================
// Order
// ============================================

model Order {
  id                      Int       @id @default(autoincrement())
  orderNumber             String    @unique
  usdToTryRateAtOrder     Float?
  moneyTransferCommission Float?    @default(0)
  otherCommissions        Float?    @default(0)
  totalAmount             Float
  discount                Float     @default(0)
  finalAmount             Float
  paymentMethod           String
  pay                     String?
  receiverName            String?
  receiverPhone           String[]
  country                 String?
  city                    String?
  invoiceImage            String?
  municipality            String?
  fullAddress             String?
  deliveryNotes           String?
  googleMapsLink          String?
  amount                  String?
  amountBank              String?
  deliveryMethod          String?
  additionalNotes         String?
  status                  String    @default("PENDING")
  customerId              String
  userId                  String?
  manualCreatedAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // ─── Relations ───
  customer Customer    @relation(fields: [customerId], references: [id])
  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]

  // ─── E-commerce Affiliate Relations ───
  commissions Commission[]

  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ============================================
// OrderItem
// ============================================

model OrderItem {
  id        Int   @id @default(autoincrement())
  quantity  Int   @default(1)
  price     Float
  discount  Float
  orderId   Int
  productId Int
  variantId Int?

  // ─── E-commerce Affiliate tracking ───
  affiliateLinkId String?

  // ─── Relations ───
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // ─── E-commerce Affiliate Relation ───
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([affiliateLinkId])
}

// ============================================
// GeneralSetting
// ============================================

model GeneralSetting {
  id               Int      @id @default(autoincrement())
  siteName         String?
  siteTitle        String?
  siteDescription  String?
  companyEmail     String?
  companyPhone     String?
  siteCurrency     String?  @default("USD")
  usdToTryRate     Float?   @default(0)
  usdToSypRate     Float?   @default(0)
  logo             String?
  favicon          String?
  facebookUrl      String?
  instagramUrl     String?
  topBannerText    String?
  primaryColor     String?  @default("#10b981")
  secondaryColor   String?  @default("#0f766e")
  nextPublicAppUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================
// Page (Static Pages: About, Privacy Policy, etc.)
// ============================================

model Page {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pages")
}

// ============================================
// HeroSlide (E-commerce Homepage Slider)
// ============================================

model HeroSlide {
  id         String   @id @default(cuid())
  title      String?
  subtitle   String?
  image      String
  buttonText String?
  buttonLink String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("hero_slides")
}

// ============================================
// AffiliateLink
// ============================================

model AffiliateLink {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  productId      Int      @map("product_id")
  uniqueCode     String   @unique @map("unique_code")
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  commissionRate Float    @default(10.00) @map("commission_rate")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  commissions Commission[]

  @@index([userId])
  @@index([productId])
  @@index([uniqueCode])
  @@map("affiliate_links")
}

// ============================================
// Offer (Homepage / Marketing Offers)
// ============================================

model Offer {
  id              String    @id @default(cuid())
  title           String?
  subtitle        String?
  description     String?   @db.Text
  badgeText       String?
  image           String?
  ctaText         String?
  ctaLink         String?
  startsAt        DateTime?
  endsAt          DateTime?
  countdownEndsAt DateTime?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  discounts OfferDiscount[]

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
  @@map("offers")
}

// ============================================
// OfferDiscount (Discount Rules for Offers)
// ============================================

model OfferDiscount {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  // Optional targeting (can stay null)
  productId  Int?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  discountType     DiscountType @default(PERCENTAGE)
  discountValue    Float?
  maxDiscountValue Float?
  minOrderAmount   Float?
  usageLimit       Int?
  usedCount        Int          @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([offerId, isActive])
  @@index([productId])
  @@index([categoryId])
  @@index([startsAt, endsAt])
  @@map("offer_discounts")
}

// ============================================
// Commission
// ============================================

model Commission {
  id              String           @id @default(uuid())
  affiliateLinkId String           @map("affiliate_link_id")
  orderId         Int              @map("order_id")
  amount          Float
  status          CommissionStatus @default(PENDING)
  createdAt       DateTime         @default(now()) @map("created_at")
  paidAt          DateTime?        @map("paid_at")

  // Relations
  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([affiliateLinkId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("commissions")
}

model AffiliateWalletTransfer {
  id            String               @id @default(uuid())
  userId        String               @map("user_id")
  amount        Float
  status        WalletTransferStatus @default(PENDING)
  reference     String?
  notes         String?
  transferredAt DateTime             @default(now()) @map("transferred_at")
  receivedAt    DateTime?            @map("received_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([transferredAt])
  @@map("affiliate_wallet_transfers")
}
